# Copy this file to .env and replace all placeholder values.
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# Generate a unique random secret of at least 32 characters. Never commit .env.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# Comma-separated exact frontend origins; update this for your deployed frontend.
CLIENT_ORIGIN=http://localhost:3000
# Demo mode exposes OTPs in API responses/logs. Keep false outside local demos.
DEMO_OTP_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
